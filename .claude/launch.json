{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@supaluv/web", "dev"],
      "port": 5173
    },
    {
      "name": "full",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:full"],
      "port": 5173
    },
    {
      "name": "full-unmetered",
      "runtimeExecutable": "env",
      "runtimeArgs": ["VITE_SUPALUV_AI_ALLOW_UNMETERED=1", "pnpm", "dev:full"],
      "port": 5173
    }
  ]
}
