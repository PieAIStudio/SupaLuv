# Split real local values by trust boundary:
#   server-only -> /Users/yuanfei/PieAI/.secrets/supaluv/local.server.env
#   VITE_*      -> /Users/yuanfei/PieAI/.secrets/supaluv/local.public.env
# chmod 600 both files. Never commit real values.

# --- AI (server-side only) ---
OPENROUTER_API_KEY=
# Default for text branches, AI endings, character images, and generated-character review.
SUPALUV_OPENROUTER_MODEL=google/gemini-3.5-flash
SUPALUV_CHARACTER_IMAGE_PROVIDER=openrouter
# Optional future direct-Google mode only:
# SUPALUV_CHARACTER_IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=
# Gemini thinking effort: minimal | low | medium | high
SUPALUV_THINKING_LEVEL=high
SUPALUV_AI_BRANCH_PORT=8787

# --- PostHog product analytics (browser) ---
# Prefer a SupaLuv-specific project key in production.
# Same org is fine; same project key mixes funnels with other products.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_ENABLE_POSTHOG=true

# Vite loads only local.public.env and rejects server-only keys.

# --- SwimmerBackend Auth + Realtime (preferred) ---
VITE_SWIMMER_BACKEND_SUPABASE_URL=https://lgoknzuxefecikfyvpzk.supabase.co
VITE_SWIMMER_BACKEND_PUBLISHABLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Wallet metering (ai-branch server) ---
# Service role — never put in VITE_*. Required for real reserve/commit.
# SWIMMER_BACKEND_SUPABASE_URL=https://lgoknzuxefecikfyvpzk.supabase.co
# SWIMMER_BACKEND_SECRET_KEY=
# SUPALUV_SWIMMER_APP_ID=supaluv
# SUPALUV_AI_BRANCH_COST_BATTERIES=1
# SUPALUV_TTS_COST_BATTERIES=0
# Local framework without Core wallet app:
# SUPALUV_WALLET_OPTIONAL=1
# VITE_SUPALUV_AI_ALLOW_UNMETERED=1
# SUPALUV_TTS_ALLOW_FREEFORM=0
