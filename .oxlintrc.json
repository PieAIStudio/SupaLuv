{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "off",
    "no-debugger": "error",
    "no-unused-vars": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.vite/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "docs/reference/source-material/**",
    "**/*.min.js",
    "**/*.d.ts"
  ],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "vitest": true
  }
}
