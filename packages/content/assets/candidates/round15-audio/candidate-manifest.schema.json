{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supalu.v/schemas/round15-audio-candidate-manifest.schema.json",
  "title": "SupaLuv Round 15 audio candidate manifest",
  "type": "object",
  "required": ["schemaVersion", "packageId", "candidate_only", "humanListeningReview", "rightsClearance", "counts", "candidates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "const": "round15-audio" },
    "candidate_only": { "const": true },
    "humanListeningReview": { "const": false },
    "rightsClearance": { "const": "not_granted" },
    "counts": {
      "type": "object",
      "required": ["music", "ambience", "sfx", "total"],
      "properties": {
        "music": { "const": 7 },
        "ambience": { "const": 6 },
        "sfx": { "const": 8 },
        "total": { "const": 21 }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": {
        "type": "object",
        "required": ["stableId", "kind", "function", "sequenceMapping", "file", "provenance", "transformation", "technical", "loopCandidate", "candidate_only", "humanListeningReview", "rightsClearance"],
        "properties": {
          "stableId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "kind": { "enum": ["music", "ambience", "sfx"] },
          "function": { "type": "string", "minLength": 1 },
          "sequenceMapping": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^SQ(?:0[1-9]|1[0-3])$" } },
          "cue": { "type": "string" },
          "file": { "type": "string", "pattern": "^audio/(music|ambience|sfx)/[a-z0-9-]+\\.mp3$" },
          "provenance": {
            "type": "object",
            "required": ["sourceRecordId", "provider", "itemUrl", "sourcePath", "claimedLicense", "sourceSha256"],
            "properties": {
              "sourceRecordId": { "type": "string" },
              "provider": { "enum": ["Incompetech", "Freesound"] },
              "itemUrl": { "type": "string", "format": "uri" },
              "sourcePath": { "type": "string", "minLength": 1 },
              "claimedLicense": { "type": "string", "minLength": 1 },
              "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          },
          "transformation": { "type": "string", "minLength": 1 },
          "technical": {
            "type": "object",
            "required": ["codec", "sampleRate", "channels", "durationSeconds", "integratedLufs", "truePeakDbtp", "bytes", "sha256"],
            "properties": {
              "codec": { "const": "mp3" },
              "sampleRate": { "const": 44100 },
              "channels": { "enum": [1, 2] },
              "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "integratedLufs": { "type": "number" },
              "truePeakDbtp": { "type": "number", "maximum": -2 },
              "bytes": { "type": "integer", "exclusiveMinimum": 0 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          },
          "loopCandidate": { "type": "boolean" },
          "candidate_only": { "const": true },
          "humanListeningReview": { "const": false },
          "rightsClearance": { "const": "not_granted" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
