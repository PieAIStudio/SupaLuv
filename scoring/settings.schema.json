{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pieai.dev/pgs/scoring/settings-v1.json",
  "title": "PGS look and code score settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pages", "code"],
  "properties": {
    "version": { "const": 1 },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "ready", "references"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "path": { "type": "string", "pattern": "^/" },
          "ready": { "type": "string", "minLength": 1 },
          "references": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "passMarks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "look": { "type": "number", "minimum": 8.5, "maximum": 10 },
        "lookItem": { "type": "number", "minimum": 7, "maximum": 10 },
        "code": { "type": "number", "minimum": 8.5, "maximum": 10 },
        "codeItem": { "type": "number", "minimum": 7, "maximum": 10 },
        "refactorBelow": { "type": "number", "minimum": 7, "maximum": 10 }
      }
    },
    "look": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "prepareModule": { "type": "string", "minLength": 1 },
        "ignore": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selector", "reason"],
            "properties": {
              "selector": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "commands"],
      "properties": {
        "include": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "maxFileLines": { "type": "integer", "minimum": 1 },
        "maxComplexity": { "type": "integer", "minimum": 1 },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["typecheck", "lint"],
          "properties": {
            "typecheck": { "$ref": "#/definitions/command" },
            "lint": { "$ref": "#/definitions/command" }
          }
        },
        "dependencyRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "from", "to"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 }
            }
          }
        },
        "coverage": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "command": {
      "type": ["array", "null"],
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
